# Any OpenAI-compatible endpoint works: OpenAI, Groq, Together, or a local Ollama server.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Local example with Ollama:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

CHROMA_DIR=chroma_db
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
